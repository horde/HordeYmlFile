{
    "name": "horde/hordeymlfile",
    "description": "Handle .horde.yml file and changelog.yml file",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "contributor"
        }
    ],
    "time": "2025-05-11",
    "repositories": [],
    "require": {
        "php": "^8.2",
        "horde/yaml": "dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2"
    },
    "suggest": {},
    "autoload": {
        "psr-4": {
            "Horde\\HordeYmlFile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\HordeYmlFile\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
