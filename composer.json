{
    "name": "horde/hordeymlfile",
    "description": "Handle .horde.yml file and changelog.yml file",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "contributor"
        }
    ],
    "keywords": [
        "metadata",
        "changelog",
        "composer"
    ],
    "time": "2026-03-29",
    "repositories": [],
    "require": {
        "php": "^8.2",
        "horde/version": "^1 || dev-FRAMEWORK_6_0",
        "horde/yaml": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2"
    },
    "suggest": {},
    "autoload": {
        "psr-4": {
            "Horde\\HordeYmlFile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\HordeYmlFile\\Test\\": "test/",
            "Horde\\HordeYmlFile\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "0.x-dev"
        }
    }
}